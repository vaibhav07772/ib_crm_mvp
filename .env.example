# ====================== FREE APIs ======================
# Groq API Key (FREE) - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Hunter.io API Key (FREE tier available) - https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# Apollo is mostly paid, so we keep it optional
APOLLO_API_KEY=

# ====================== EMAIL (Gmail App Password) ======================
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ====================== STUDENT DETAILS ======================
STUDENT_NAME=John Doe
STUDENT_UNIVERSITY=XYZ University
STUDENT_MAJOR=Finance
STUDENT_GRADUATION_YEAR=2027
STUDENT_LINKEDIN=https://linkedin.com/in/johndoe
STUDENT_EMAIL=john.doe@university.edu

# ====================== SETTINGS ======================
DAILY_EMAIL_LIMIT=15
GROQ_MODEL=llama-3.1-8b-instant